{
  "schemaVersion": 1,
  "id": "skyseq",
  "version": "${version}",
  "name": "SkySeq Macros",
  "description": "Custom keybinds that run sequences of commands, key presses and clicks, with cycling (e.g. loadouts). Fully configurable in-game.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.skyseq.SkySeqClient"],
    "modmenu": ["dev.skyseq.ModMenuIntegration"]
  },
  "mixins": ["skyseq.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": ">=26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
